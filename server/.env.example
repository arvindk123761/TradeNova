NODE_ENV=development
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
PUBLIC_APP_URL=http://localhost:5000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
